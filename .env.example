# MongoDB se configurará cuando se proporcione la cadena oficial.
MONGODB_URI=
MONGODB_DB=nuvib
# URL pública opcional para el entorno desplegado
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Credencial privada para subir imágenes desde el servidor
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Credenciales del administrador. Defínelas antes de ejecutar npm run admin:create
ADMIN_USERNAME=NUVIB
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=define-a-strong-password
# Número de WhatsApp público, solo dígitos con código de país. Opcional.
NUVIB_WHATSAPP_NUMBER=
# Proveedor autorizado de reseñas externas. Nunca exponer estas claves al frontend.
REVIEWS_API_URL=
REVIEWS_API_KEY=
ALIEXPRESS_REVIEWS_API_KEY=
